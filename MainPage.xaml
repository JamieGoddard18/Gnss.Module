<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ocad.Gnss.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="GNSS Monitoring" FontSize="24" FontAttributes="Bold" />

            <Button Text="Settings" Clicked="OnSettingsClicked" />

            <Label x:Name="QualityLabel" Text="Quality: —" FontSize="18" />

            <Label Text="Location" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="LocationLabel" Text="Waiting for location…" />

            <Label Text="Satellites" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="SatelliteLabel" Text="Waiting for satellites…" />

            <Label Text="Raw Measurements" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="RawLabel" Text="Waiting for raw measurements…" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>